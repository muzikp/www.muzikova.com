{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build",
            "type": "shell",
            "command": "pnpm run build",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Git: Add all changes",
            "type": "shell",
            "command": "git add .",
            "problemMatcher": []
        },
        {
            "label": "Git: Commit",
            "type": "shell",
            "command": "git commit -m \"${input:commitMessage}\"",
            "problemMatcher": []
        },
        {
            "label": "Git: Push",
            "type": "shell",
            "command": "git push",
            "problemMatcher": []
        },
        {
            "label": "Deploy to GitHub Pages",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Build",
                "Git: Add all changes",
                "Git: Commit",
                "Git: Push"
            ],
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "commitMessage",
            "type": "promptString",
            "description": "Commit message",
            "default": "Update website"
        }
    ]
}
